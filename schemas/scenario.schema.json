{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo.course.invalid/contracts/lora-energy-v1/scenario.schema.json",
  "title": "LoRa energy scenario package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "course_id", "runner_contract_version", "scenario_id",
    "scenario_sha256", "scenario_anchor_sha256", "source_mode", "target_utc",
    "tle_source_id", "scenario_anchor", "runner", "units", "clock",
    "contact_windows", "quality_band_trace", "traffic_cards",
    "endpoint_energy_profile", "mission_contract", "cases", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "lora-energy-scenario-v1"},
    "course_id": {"const": "LORA-ENERGY-DECISION-1R"},
    "runner_contract_version": {"const": "lora-energy-leo-v1"},
    "scenario_id": {"const": "ntpu-energy-decision-01"},
    "scenario_sha256": {"$ref": "#/$defs/hash"},
    "scenario_anchor_sha256": {"$ref": "#/$defs/hash"},
    "source_mode": {"enum": ["bundled", "fallback"]},
    "target_utc": {"const": "2026-08-09T04:00:00Z"},
    "tle_source_id": {"const": "oneweb-0314-archive-2026-08-08"},
    "scenario_anchor": {"$ref": "#/$defs/anchor"},
    "runner": {"$ref": "#/$defs/runner"},
    "units": {"$ref": "#/$defs/runnerUnits"},
    "clock": {"$ref": "#/$defs/clock"},
    "contact_windows": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/contactWindow"}
    },
    "quality_band_trace": {"$ref": "#/$defs/qualityTrace"},
    "traffic_cards": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/trafficCard"}
    },
    "endpoint_energy_profile": {"$ref": "#/$defs/energyProfile"},
    "mission_contract": {"$ref": "#/$defs/missionContract"},
    "cases": {
      "type": "array", "minItems": 10, "maxItems": 16,
      "items": {"$ref": "#/$defs/case"}
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claimBoundary": {"const": "SIMULATED TEACHING DATA / NOT LIVE / NOT MEASURED / NOT CANONICAL-PARITY-VERIFIED"},
    "anchorUnits": {
      "type": "object", "additionalProperties": false,
      "required": ["elapsedTime", "activeTime", "deadline", "freshness", "power", "consumedEnergy", "energyBudget", "rate", "deliveredData", "energyEfficiency", "angle", "distance", "quality"],
      "properties": {
        "elapsedTime": {"const": "s"}, "activeTime": {"const": "s"},
        "deadline": {"const": "s"}, "freshness": {"const": "s"},
        "power": {"const": "W"}, "consumedEnergy": {"const": "J"},
        "energyBudget": {"const": "J"}, "rate": {"const": "bit/s"},
        "deliveredData": {"const": "bit"}, "energyEfficiency": {"const": "bit/J"},
        "angle": {"const": "deg"}, "distance": {"const": "km"},
        "quality": {"const": "teaching-band"}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["course_id", "contract_version", "provider_kind", "provider_id", "fixture_id", "fixture_version", "scenario_id", "source_mode", "tle_source_id", "target_utc", "claim_boundary", "claim_levels", "units"],
      "properties": {
        "course_id": {"const": "LORA-ENERGY-DECISION-1R"},
        "contract_version": {"const": "lora-fixture-first-v2"},
        "provider_kind": {"enum": ["fixture", "canonical-adapter"]},
        "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fixture_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fixture_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "scenario_id": {"const": "ntpu-energy-decision-01"},
        "source_mode": {"enum": ["bundled", "fallback"]},
        "tle_source_id": {"const": "oneweb-0314-archive-2026-08-08"},
        "target_utc": {"const": "2026-08-09T04:00:00Z"},
        "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
        "claim_levels": {
          "const": ["SIMULATED_TEACHING_DATA", "NOT_LIVE", "NOT_MEASURED", "NOT_CANONICAL_PARITY_VERIFIED"]
        },
        "units": {"$ref": "#/$defs/anchorUnits"}
      }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream_repository", "upstream_commit", "wrapper_version", "policy_api_version", "seed", "engine_mode", "upstream_execution"],
      "properties": {
        "upstream_repository": {"const": "https://github.com/GillesC/LoRaEnergySim"},
        "upstream_commit": {"const": "f854462cda0cd30cb56e3f0c576cb004711842f6"},
        "wrapper_version": {"const": "lora-energy-runner-v1"},
        "policy_api_version": {"const": "lora-energy-policy-v1"},
        "seed": {"const": 12001},
        "engine_mode": {"const": "coherent-course-simulated-adapter"},
        "upstream_execution": {"const": false}
      }
    },
    "runnerUnits": {
      "type": "object", "additionalProperties": false,
      "required": ["time", "power", "energy", "data", "rate"],
      "properties": {
        "time": {"const": "s"}, "power": {"const": "W"},
        "energy": {"const": "J"}, "data": {"const": "bit"},
        "rate": {"const": "bit/s"}
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["step_s", "duration_s"],
      "properties": {
        "step_s": {"type": "integer", "minimum": 1, "maximum": 60},
        "duration_s": {"type": "integer", "minimum": 60, "maximum": 3600}
      }
    },
    "contactWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["contact_id", "satellite_id", "source_id", "start_s", "end_s", "quality_trace_id", "handover_target_id"],
      "properties": {
        "contact_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
        "satellite_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_id": {"const": "oneweb-0314-archive-2026-08-08"},
        "start_s": {"type": "integer", "minimum": 0},
        "end_s": {"type": "integer", "minimum": 1},
        "quality_trace_id": {"const": "ntpu-quality-course-v1"},
        "handover_target_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 64}]}
      }
    },
    "qualityTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "ordinal_labels", "points"],
      "properties": {
        "trace_id": {"const": "ntpu-quality-course-v1"},
        "ordinal_labels": {"const": ["closed", "weak", "usable", "strong"]},
        "points": {
          "type": "array", "minItems": 2, "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["elapsed_s", "contact_id", "quality_band"],
            "properties": {
              "elapsed_s": {"type": "integer", "minimum": 0},
              "contact_id": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 64}]},
              "quality_band": {"type": "integer", "minimum": 0, "maximum": 3}
            }
          }
        }
      }
    },
    "trafficCard": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_id", "class", "generated_s", "deadline_s", "freshness_limit_s", "payload_bits", "destination_id"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
        "class": {"enum": ["normal", "urgent"]},
        "generated_s": {"type": "integer", "minimum": 0},
        "deadline_s": {"type": "integer", "minimum": 1},
        "freshness_limit_s": {"type": "integer", "minimum": 1},
        "payload_bits": {"type": "integer", "minimum": 1},
        "destination_id": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "energyProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "sleep_power_w", "awake_idle_power_w", "process_power_w", "tx_power_w", "rx_power_w", "wake_energy_j", "wake_latency_s"],
      "properties": {
        "scope": {"const": "endpoint-radio-and-processing-course-assumptions"},
        "sleep_power_w": {"type": "number", "exclusiveMinimum": 0},
        "awake_idle_power_w": {"type": "number", "exclusiveMinimum": 0},
        "process_power_w": {"type": "number", "exclusiveMinimum": 0},
        "tx_power_w": {"type": "number", "exclusiveMinimum": 0},
        "rx_power_w": {"type": "number", "exclusiveMinimum": 0},
        "wake_energy_j": {"type": "number", "minimum": 0},
        "wake_latency_s": {"type": "number", "minimum": 0}
      }
    },
    "missionContract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "evaluation_end_s", "required_packet_ids", "minimum_unique_delivered_bits", "deadline_rule", "freshness_rule", "maximum_expired_packets", "system_boundary_id", "power_model_id"],
      "properties": {
        "contract_id": {"const": "mission-fixed-service-boundary"},
        "evaluation_end_s": {"type": "integer", "minimum": 1},
        "required_packet_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "minimum_unique_delivered_bits": {"type": "integer", "minimum": 1},
        "deadline_rule": {"const": "required-packets-before-deadline"},
        "freshness_rule": {"const": "delivered-age-within-card-limit"},
        "maximum_expired_packets": {"type": "integer", "minimum": 0},
        "system_boundary_id": {"const": "endpoint-radio-and-processing-only"},
        "power_model_id": {"const": "course-endpoint-energy-v1"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "lab_id", "run_role", "seed_role", "seed", "contact_window_ids", "quality_trace_id", "traffic_card_ids", "expected_predecessor_role", "expected_freeze_role", "withheld"],
      "properties": {
        "case_id": {"enum": ["baseline", "candidate", "hidden", "trace-a-baseline", "trace-a-candidate", "trace-b", "revision", "surprise"]},
        "lab_id": {"enum": ["A", "B", "C"]},
        "run_role": {"enum": ["baseline", "candidate", "revision", "withheld"]},
        "seed_role": {"type": "string", "pattern": "^lab-[abc]-[a-z0-9-]+$"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "contact_window_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "quality_trace_id": {"const": "ntpu-quality-course-v1"},
        "traffic_card_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "expected_predecessor_role": {"oneOf": [{"type": "null"}, {"enum": ["release-default", "lab-a-frozen", "lab-b-frozen", "lab-c-candidate"]}]},
        "expected_freeze_role": {"oneOf": [{"type": "null"}, {"enum": ["lab-a-frozen", "lab-b-frozen", "lab-c-frozen"]}]},
        "withheld": {"type": "boolean"}
      }
    }
  }
}
